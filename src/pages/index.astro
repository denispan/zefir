---
import Benefits from "../components/Benefits.astro";
import Catalog from "../components/Catalog.astro";
import Composition from "../components/Composition.astro";
import Delivery from "../components/Delivery.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowToOrder from "../components/HowToOrder.astro";
import OrderCta from "../components/OrderCta.astro";
import StructuredData from "../components/StructuredData.astro";
import Layout from "../layouts/Layout.astro";

const title = "Зефирные тюльпаны ручной работы в Москве — м. Аэропорт | Татьяна";
const description =
  "Букеты из зефирных тюльпанов на яблочном пюре: в куполе, круглых, квадратных и узких коробках, от 350 ₽. Любые оттенки, открытка в подарок. Самовывоз у м. Аэропорт, доставка по Москве.";
---

<Layout title={title} description={description}>
  <StructuredData slot="head" description={description} />
  <Header />
  <main>
    <Hero />
    <Catalog />
    <Benefits />
    <HowToOrder />
    <Delivery />
    <Composition />
    <OrderCta />
  </main>
  <Footer />
</Layout>
