---
import { terms } from "../data/site";
import Ingredients from "./Ingredients.astro";
---

<section class="section" id="composition" aria-labelledby="composition-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Состав и хранение</p>
      <h2 id="composition-title">Из чего сделан зефир</h2>
    </div>
    <Ingredients />
    <div class="facts">
      <div class="facts__card reveal">
        <h3>Полный состав</h3>
        <p>
          Сахар, яблочное пюре, инвертный сироп (сахар, вода, лимонная кислота, сода), агар-агар,
          ванилин, пищевой краситель.
        </p>
        <p class="facts__note">В грибочках — ещё глазурь из молочного шоколада.</p>
      </div>
      <div class="facts__card reveal">
        <h3>Как хранить</h3>
        <p>
          Зефир хранится {terms.shelfLife}. Держите его в закрытом контейнере, в тёмном месте, при
          температуре от +6 до +25 °C.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }

  .facts__card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .facts__note {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  /* Когда карточки стоят рядом, правая появляется чуть позже левой. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @media (width >= 46rem) {
        .facts__card:nth-child(2) {
          animation-range: entry 8% cover 30%;
        }
      }
    }
  }
</style>
