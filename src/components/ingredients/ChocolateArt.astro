---
// Плитка молочного шоколада и отломленный кусочек, который покачивается.

const SQUARE_WIDTH = 22;
const SQUARE_HEIGHT = 21;
const squares = [0, 1, 2].flatMap((column) =>
  [0, 1].map((row) => ({ x: 20 + column * 25, y: 38 + row * 24 })),
);

function shine(x: number, y: number) {
  return `M${x + 3} ${y + SQUARE_HEIGHT - 4}V${y + 4}q0-1 1-1h${SQUARE_WIDTH - 7}`;
}
---

<svg viewBox="0 0 120 120" aria-hidden="true">
  <defs>
    <linearGradient id="ing-choco" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#a86f4c"></stop>
      <stop offset="1" stop-color="#7b4b31"></stop>
    </linearGradient>
  </defs>
  <g transform="rotate(-12 60 60)">
    <rect x="16" y="34" width="80" height="54" rx="7" fill="#6e432c"></rect>
    {squares.map((square) => (
      <g>
        <rect
          x={square.x}
          y={square.y}
          width={SQUARE_WIDTH}
          height={SQUARE_HEIGHT}
          rx="3.5"
          fill="url(#ing-choco)"
        />
        <path
          d={shine(square.x, square.y)}
          fill="none"
          stroke="#c7926b"
          stroke-width="1.4"
          stroke-linecap="round"
        />
      </g>
    ))}
  </g>
  <g transform="translate(92 94) rotate(24)">
    <g class="piece">
      <rect x="-12" y="-11" width="24" height="22" rx="4" fill="#6e432c"></rect>
      <rect x="-10" y="-9" width="20" height="18" rx="3" fill="url(#ing-choco)"></rect>
      <path
        d="M-7 6V-5q0-1 1-1h10"
        fill="none"
        stroke="#c7926b"
        stroke-width="1.4"
        stroke-linecap="round"
      ></path>
    </g>
  </g>
  <path fill="#7b4b31" d="M72 106l4-2 2 3-3 3ZM106 70l3-1 1 3-3 1ZM20 98l3-2 2 2-3 2Z"></path>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .piece {
      transform-box: fill-box;
      transform-origin: center;
      animation: wiggle 3.6s ease-in-out infinite;
    }
  }

  @keyframes wiggle {
    50% {
      transform: rotate(-10deg) translateY(-2px);
    }
  }
</style>
