---
import DomeAssembly from "./DomeAssembly.astro";

const benefits = [
  {
    title: "Заварной зефир на яблочном пюре",
    text: "Нежный, воздушный, с яблочным вкусом. А лепестки при этом хорошо держат форму.",
  },
  {
    title: "Оттенки — любые",
    text: "Подберу под праздник или под любимый цвет. Если вы против красителей, сделаю совсем белые тюльпаны с чуть зелёными листиками.",
  },
  {
    title: "Открытка и тюльпан на пробу",
    text: "В каждый набор кладу открытку с пожеланием. А для вас — отдельный тюльпан, чтобы вы сами попробовали зефир.",
  },
  {
    title: "Домашняя кухня",
    text: "Готовлю сама, у себя дома, и только под заказ. Домашних животных нет.",
  },
];
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container benefits">
    <DomeAssembly />
    <div>
      <div class="section-head reveal">
        <p class="eyebrow">Как я готовлю</p>
        <h2 id="about-title">Каждый букет собираю вручную</h2>
      </div>
      <ul class="benefits__list">
        {benefits.map((benefit) => (
          <li class="reveal">
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .benefits {
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .benefits__list {
    display: grid;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .benefits__list li {
    display: grid;
    gap: 0.35rem;
    padding-left: 1.25rem;
    border-left: 2px solid color-mix(in srgb, var(--accent) 35%, var(--line));
  }

  .benefits__list h3 {
    font-size: 1.45rem;
  }

  .benefits__list p {
    color: var(--ink-soft);
  }

  @media (width >= 56rem) {
    .benefits {
      grid-template-columns: 1fr 1.1fr;
    }
  }
</style>
