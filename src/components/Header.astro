---
import { business } from "../data/site";
import { telegramUrl } from "../lib/links";
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href="/" aria-label={`${business.name} — ${business.tagline}, на главную`}>
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path
          fill="#9fb49a"
          d="M16 30c-1-3.6-4.4-5.8-8.6-5.8 2 2.9 4.8 4.9 8.6 5.8Zm0 0c1-3.6 4.4-5.8 8.6-5.8-2 2.9-4.8 4.9-8.6 5.8Z"
        ></path>
        <path
          fill="#e59aae"
          d="M16 27c-5.7 0-8.8-3.8-8.8-9.6 0-3.9 1.2-7.4 3-9.6l2.9 3.7L16 4.3l2.9 7.2 2.9-3.7c1.8 2.2 3 5.7 3 9.6 0 5.8-3.1 9.6-8.8 9.6Z"
        ></path>
        <path
          fill="#f8d3dc"
          d="M16 27c-2.9 0-4.9-3.9-4.9-8.8 0-4 1.9-7.6 4.9-10.6 3 3 4.9 6.6 4.9 10.6 0 4.9-2 8.8-4.9 8.8Z"
        ></path>
      </svg>
      <span class="brand__text">
        <span class="brand__name">{business.name}</span>
        <span class="brand__note">зефирные цветы</span>
      </span>
    </a>
    <nav class="nav" aria-label="Разделы страницы">
      <a href="/#catalog">Наборы</a>
      <a href="/#reviews">Отзывы</a>
      <a href="/#delivery">Доставка</a>
      <a href="/#order">Контакты</a>
    </nav>
    <a
      class="button button--primary header__cta"
      href={telegramUrl()}
      target="_blank"
      rel="noopener"
    >
      Заказать
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    background: var(--bg);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-height);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    text-decoration: none;
  }

  .brand__mark {
    width: 2rem;
    height: 2rem;
  }

  .brand__text {
    display: grid;
    line-height: 1;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
  }

  .brand__note {
    color: var(--ink-soft);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav {
    display: none;
    gap: 1.75rem;
    font-size: 0.95rem;
  }

  .nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--ink);
  }

  .header__cta {
    min-height: 2.6rem;
    padding: 0.5rem 1.15rem;
    font-size: 0.95rem;
  }

  @media (width >= 48rem) {
    .nav {
      display: flex;
    }
  }
</style>
